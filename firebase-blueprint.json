{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated farmer or admin account profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator access record for NASA data management.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Field": {
      "title": "Field",
      "description": "Personalized agricultural plot profile stored under a farmer's user scope.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120
        },
        "sharedWithEmails": {
          "type": "array"
        },
        "sharedWithUids": {
          "type": "array"
        },
        "activeShareToken": {
          "type": "string",
          "maxLength": 128
        },
        "presentedShareToken": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 150
        },
        "province": {
          "type": "string",
          "maxLength": 100
        },
        "district": {
          "type": "string",
          "maxLength": 120
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "areaHa": {
          "type": "number"
        },
        "soilType": {
          "type": "string",
          "maxLength": 40
        },
        "soilCharacteristics": {
          "type": "object"
        },
        "waterSource": {
          "type": "object"
        },
        "crop": {
          "type": "object"
        },
        "primaryGoal": {
          "type": "string",
          "maxLength": 50
        },
        "inspectTime": {
          "type": "string",
          "maxLength": 30
        },
        "notificationMethod": {
          "type": "string",
          "maxLength": 30
        },
        "nasaGrid": {
          "type": "object"
        },
        "adaptiveMemory": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "province",
        "district",
        "lat",
        "lon",
        "areaHa",
        "soilType",
        "soilCharacteristics",
        "waterSource",
        "crop",
        "primaryGoal",
        "inspectTime",
        "notificationMethod",
        "nasaGrid",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlotPlan": {
      "title": "PlotPlan",
      "description": "Persisted crop rotation strategy, farmer constraints, rejected proposals, and 12-month calendar selection per plot.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "plotId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "priorities": {
          "type": "array"
        },
        "constraints": {
          "type": "object"
        },
        "activeStrategy": {
          "type": "object"
        },
        "rejectedIds": {
          "type": "array"
        },
        "rejectedTitles": {
          "type": "array"
        },
        "lastRejectionNote": {
          "type": "string",
          "maxLength": 500
        },
        "calendarCropKey": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "plotId",
        "priorities",
        "constraints",
        "rejectedIds",
        "rejectedTitles",
        "createdAt",
        "updatedAt"
      ]
    },
    "EarthMetric": {
      "title": "EarthMetric",
      "description": "NASA OCO-2/3 carbon flux, GRACE groundwater anomaly, GHGx/EDGAR emissions, and SMAP/MODIS snapshot linked to a plot.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fieldId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "syncedAt": {
          "type": "string",
          "maxLength": 40
        },
        "sustainabilityScore": {
          "type": "number"
        },
        "rotationAdvice": {
          "type": "string",
          "maxLength": 600
        },
        "rotationAdviceEn": {
          "type": "string",
          "maxLength": 600
        },
        "nasaPowerLastUpdated": {
          "type": "string",
          "maxLength": 40
        },
        "smapModis": {
          "type": "object"
        },
        "carbonFluxOco2": {
          "type": "object"
        },
        "groundwaterAnomalyGrace": {
          "type": "object"
        },
        "greenhouseGasEdgar": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "fieldId",
        "syncedAt",
        "sustainabilityScore",
        "rotationAdvice",
        "carbonFluxOco2",
        "groundwaterAnomalyGrace",
        "greenhouseGasEdgar",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedRef": {
      "title": "SharedRef",
      "description": "Recipient reference pointer allowing zero-index access to shared plots redeemed via share token.",
      "type": "object",
      "properties": {
        "recipientUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "plotId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shareToken": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["recipientUid", "ownerId", "plotId", "shareToken", "createdAt"]
    },
    "FarmTask": {
      "title": "FarmTask",
      "description": "Agronomic action task linked to a farmer's plot.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fieldId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "scheduledTime": {
          "type": "string",
          "maxLength": 100
        },
        "priority": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"]
        },
        "reason": {
          "type": "string",
          "maxLength": 600
        },
        "triggerData": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "postponed", "skipped"]
        },
        "farmerNote": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "fieldId",
        "title",
        "scheduledTime",
        "priority",
        "reason",
        "triggerData",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "FeedbackRecord": {
      "title": "FeedbackRecord",
      "description": "Field observation and feedback submitted by a farmer.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fieldId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "feedbackType": {
          "type": "string",
          "maxLength": 50
        },
        "userComment": {
          "type": "string",
          "maxLength": 1000
        },
        "systemActionTaken": {
          "type": "string",
          "maxLength": 500
        },
        "predictionOutcome": {
          "type": "string",
          "enum": ["on_track", "needs_adjustment", "off_track"]
        },
        "observedMoisture": {
          "type": "string",
          "enum": ["dry", "balanced", "wet"]
        },
        "observedCropHealth": {
          "type": "string",
          "enum": ["healthy", "stressed", "pest_risk"]
        },
        "recommendedFixes": {
          "type": "array"
        },
        "appliedToProfile": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "fieldId",
        "feedbackType",
        "appliedToProfile",
        "createdAt"
      ]
    },
    "NasaDataset": {
      "title": "NasaDataset",
      "description": "Admin-uploaded NASA climate observation dataset manifest and representative overrides.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 80
        },
        "fileName": {
          "type": "string",
          "maxLength": 200
        },
        "recordCount": {
          "type": "number"
        },
        "cellCount": {
          "type": "number"
        },
        "startDate": {
          "type": "string",
          "maxLength": 20
        },
        "endDate": {
          "type": "string",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "ROLLED_BACK"]
        },
        "uploadedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isPublic": {
          "type": "boolean"
        },
        "sampleOverrides": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "version",
        "fileName",
        "recordCount",
        "cellCount",
        "startDate",
        "endDate",
        "status",
        "uploadedBy",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "NasaSyncLog": {
      "title": "NasaSyncLog",
      "description": "Admin-only synchronization audit log.",
      "type": "object",
      "properties": {
        "syncType": {
          "type": "string",
          "maxLength": 40
        },
        "targetCellsCount": {
          "type": "number"
        },
        "recordsSynced": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["RUNNING", "SUCCESS", "FAILED", "PARTIAL"]
        },
        "latestNasaDate": {
          "type": "string",
          "maxLength": 20
        },
        "actorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "syncType",
        "targetCellsCount",
        "recordsSynced",
        "status",
        "actorUid",
        "createdAt"
      ]
    },
    "FieldShare": {
      "title": "FieldShare",
      "description": "Share link or email invitation granting read access to a farmer's plot.",
      "type": "object",
      "properties": {
        "fieldId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fieldName": {
          "type": "string",
          "maxLength": 150
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120
        },
        "shareType": {
          "type": "string",
          "enum": ["link", "email"]
        },
        "targetEmail": {
          "type": "string",
          "maxLength": 200
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "fieldId",
        "fieldName",
        "ownerId",
        "ownerName",
        "shareType",
        "isActive",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile isolated to owner and admin."
    },
    "/users/{userId}/plots/{plotId}": {
      "schema": { "$ref": "#/entities/Field" },
      "description": "Farmer-owned agricultural plot profiles strictly isolated to owner, explicitly shared recipients, and admin."
    },
    "/users/{userId}/plans/{planId}": {
      "schema": { "$ref": "#/entities/PlotPlan" },
      "description": "Crop rotation strategy, constraints, rejection history, and 12-month calendar choice linked to a plot."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/FarmTask" },
      "description": "Agronomic action tasks linked to a farmer's plot."
    },
    "/users/{userId}/feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/FeedbackRecord" },
      "description": "Farmer plot observations and field feedback records."
    },
    "/users/{userId}/earth_metrics/{metricId}": {
      "schema": { "$ref": "#/entities/EarthMetric" },
      "description": "NASA OCO-2/GRACE/GHGx/SMAP sustainability snapshots tied to a plot."
    },
    "/users/{userId}/shared_refs/{plotId}": {
      "schema": { "$ref": "#/entities/SharedRef" },
      "description": "Pointer entries for plots shared with the user via share token."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted admin allowlist records."
    },
    "/field_shares/{shareId}": {
      "schema": { "$ref": "#/entities/FieldShare" },
      "description": "Plot sharing links and email invitations created by plot owners."
    },
    "/nasa_datasets/{datasetId}": {
      "schema": { "$ref": "#/entities/NasaDataset" },
      "description": "Admin-uploaded NASA dataset manifests and representative climate overrides."
    },
    "/nasa_sync_logs/{logId}": {
      "schema": { "$ref": "#/entities/NasaSyncLog" },
      "description": "Admin-only NASA synchronization audit logs."
    }
  }
}
