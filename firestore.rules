rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vanha.uow@gmail.com' ||
        request.auth.token.email == 'fss01211cg@gmail.com' ||
        request.auth.token.email in ['vanha.uow@gmail.com', 'fss01211cg@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Users Collection & Subcollections
    match /users {
      allow list: if isAdmin();
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();

      match /plots {
        allow list: if isSignedIn() && request.auth.uid == userId;
      }
      match /plots/{plotId} {
        allow read, write, list: if isSignedIn() && request.auth.uid == userId;
        allow read: if isSignedIn() && (
          ('sharedWithUids' in resource.data && request.auth.uid in resource.data.sharedWithUids) ||
          ('sharedWithEmails' in resource.data && request.auth.token.email != null && request.auth.token.email in resource.data.sharedWithEmails) ||
          isAdmin()
        );
      }

      match /plans {
        allow list: if isSignedIn() && request.auth.uid == userId;
      }
      match /plans/{planId} {
        allow read, write, list: if isSignedIn() && request.auth.uid == userId;
      }

      match /tasks {
        allow list: if isSignedIn() && request.auth.uid == userId;
      }
      match /tasks/{taskId} {
        allow read, write, list: if isSignedIn() && request.auth.uid == userId;
      }

      match /feedbacks {
        allow list: if isSignedIn() && request.auth.uid == userId;
      }
      match /feedbacks/{feedbackId} {
        allow read, write, list: if isSignedIn() && request.auth.uid == userId;
      }

      match /earth_metrics {
        allow list: if isSignedIn() && request.auth.uid == userId;
      }
      match /earth_metrics/{metricId} {
        allow read, write, list: if isSignedIn() && request.auth.uid == userId;
      }

      match /shared_refs {
        allow list: if isSignedIn() && request.auth.uid == userId;
      }
      match /shared_refs/{plotId} {
        allow read, write, list: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Admins Collection
    match /admins {
      allow list: if isAdmin();
      allow read, write: if isAdmin();
    }
    match /admins/{userId} {
      allow read, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Field Shares
    match /field_shares {
      allow list: if isSignedIn();
    }
    match /field_shares/{shareId} {
      allow read, list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.isActive == true ||
        (resource.data.targetEmail != null && request.auth.token.email != null && resource.data.targetEmail == request.auth.token.email) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // NASA Datasets
    match /nasa_datasets {
      allow list: if isSignedIn();
    }
    match /nasa_datasets/{datasetId} {
      allow read, list: if resource.data.isPublic == true || isSignedIn();
      allow write: if isAdmin();
    }

    // NASA Sync Logs
    match /nasa_sync_logs {
      allow list: if isAdmin();
    }
    match /nasa_sync_logs/{logId} {
      allow read, write, list: if isAdmin();
    }
  }
}
